{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "teammateMode": "in-process",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5"
  },
  "autoMemoryEnabled": true,
  "extraKnownMarketplaces": {
    "deb-workspace-mods": {
      "source": {
        "source": "github",
        "repo": "dmazumdar186/deb-antigravity-claude-workspace"
      }
    }
  },
  "enabledPlugins": {
    "jev-router-mod@deb-workspace-mods": true,
    "safety-guard-mod@deb-workspace-mods": true,
    "done-notify-mod@deb-workspace-mods": true,
    "session-ledger-mod@deb-workspace-mods": true,
    "context-meter@deb-workspace-mods": true,
    "quota-watch@deb-workspace-mods": true,
    "tool-timing@deb-workspace-mods": true
  },
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "low"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "low"
    },
    "claude-fable-5-1": {
      "effortLevel": "low"
    }
  },
  "awaySummaryEnabled": false,
  "bashOutputMaxChars": 20000,
  "workflowSizeGuideline": "small",
  "permissions": {
    "allow": [
      "Bash(python execution/**/*.py)",
      "Bash(py execution/**/*.py)",
      "Bash(python3 execution/**/*.py)",
      "Bash(python execution/generate_registry.py)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Read(C:\\Users\\deban\\dev\\anneal\\**)",
      "Read(C:\\Users\\deban\\dev\\humanizer\\**)",
      "Read(C:\\Users\\deban\\dev\\youtube-video-analyzer\\**)",
      "Read(C:\\Users\\deban\\dev\\cv-optimizer-agent\\**)",
      "Read(C:\\Users\\deban\\dev\\mobile-apps\\**)",
      "Edit(C:\\Users\\deban\\dev\\anneal\\**)",
      "Edit(C:\\Users\\deban\\dev\\humanizer\\**)",
      "Edit(C:\\Users\\deban\\dev\\youtube-video-analyzer\\**)",
      "Write(C:\\Users\\deban\\dev\\anneal\\**)",
      "Write(C:\\Users\\deban\\dev\\humanizer\\**)",
      "Write(C:\\Users\\deban\\dev\\youtube-video-analyzer\\**)",
      "Glob(C:\\Users\\deban\\dev\\**)",
      "Grep(C:\\Users\\deban\\dev\\**)",
      "Bash(ls C:\\Users\\deban\\dev\\**)",
      "Bash(dir C:\\Users\\deban\\dev\\**)",
      "Bash(git -C C:\\Users\\deban\\dev\\humanizer\\* *)",
      "Bash(cd C:\\Users\\deban\\dev\\humanizer\\* && *)",
      "Bash(git add deliverables/**)",
      "Bash(git add deliverables/*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ],
    "defaultMode": "auto"
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/note-taker.sh\" \"$CLAUDE_TOOL_INPUT_FILE_PATH\"",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format-python.sh\" \"$CLAUDE_TOOL_INPUT_FILE_PATH\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/documenter-prompt.sh\" \"$CLAUDE_TOOL_INPUT_FILE_PATH\"",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 35
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verdict-table-check.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disabledMcpjsonServers": [
    "firecrawl",
    "tavily"
  ]
}
