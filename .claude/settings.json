{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5-1",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "teammateMode": "in-process",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-fable-5-1",
    "CLAUDE_MEM_MODEL": "claude-sonnet-5-5",
    "CLAUDE_MEM_TIER_SIMPLE_MODEL": "claude-sonnet-5-5",
    "CLAUDE_MEM_TIER_FAST_MODEL": "claude-sonnet-5-5",
    "CLAUDE_MEM_TIER_SMART_MODEL": "claude-sonnet-5-5",
    "CLAUDE_MEM_WORK_VIEW_CLAUDE_MODEL": "claude-sonnet-5-5"
  },
  "autoMemoryEnabled": true,
  "extraKnownMarketplaces": {
    "deb-workspace-mods": {
      "source": {
        "source": "github",
        "repo": "dmazumdar186/deb-antigravity-claude-workspace"
      }
    },
    "lemolab": {
      "source": {
        "source": "github",
        "repo": "lemomo-ai/lemo-opuscar"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    },
    "21st-dev": {
      "source": {
        "source": "github",
        "repo": "21st-dev/magic-mcp"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "enabledPlugins": {
    "jev-router-mod@deb-workspace-mods": true,
    "safety-guard-mod@deb-workspace-mods": true,
    "done-notify-mod@deb-workspace-mods": true,
    "session-ledger-mod@deb-workspace-mods": true,
    "context-meter@deb-workspace-mods": true,
    "quota-watch@deb-workspace-mods": true,
    "tool-timing@deb-workspace-mods": true,
    "lemo-opuscar@lemolab": true,
    "ponytail@ponytail": true,
    "claude-code-setup@claude-plugins-official": true,
    "egm@egm": true,
    "21st@21st-dev": true,
    "claude-mem@thedotmack": true
  },
  "effortLevel": "low",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "low"
    }
  },
  "awaySummaryEnabled": false,
  "bashOutputMaxChars": 20000,
  "workflowSizeGuideline": "small",
  "permissions": {
    "allow": [
      "Bash(python execution/**/*.py)",
      "Bash(py execution/**/*.py)",
      "Bash(python3 execution/**/*.py)",
      "Bash(python execution/generate_registry.py)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Read(C:\\Users\\deban\\dev\\anneal\\**)",
      "Read(C:\\Users\\deban\\dev\\humanizer\\**)",
      "Read(C:\\Users\\deban\\dev\\youtube-video-analyzer\\**)",
      "Read(C:\\Users\\deban\\dev\\cv-optimizer-agent\\**)",
      "Read(C:\\Users\\deban\\dev\\mobile-apps\\**)",
      "Edit(C:\\Users\\deban\\dev\\anneal\\**)",
      "Edit(C:\\Users\\deban\\dev\\humanizer\\**)",
      "Edit(C:\\Users\\deban\\dev\\youtube-video-analyzer\\**)",
      "Write(C:\\Users\\deban\\dev\\anneal\\**)",
      "Write(C:\\Users\\deban\\dev\\humanizer\\**)",
      "Write(C:\\Users\\deban\\dev\\youtube-video-analyzer\\**)",
      "Glob(C:\\Users\\deban\\dev\\**)",
      "Grep(C:\\Users\\deban\\dev\\**)",
      "Bash(ls C:\\Users\\deban\\dev\\**)",
      "Bash(dir C:\\Users\\deban\\dev\\**)",
      "Bash(git -C C:\\Users\\deban\\dev\\humanizer\\* *)",
      "Bash(cd C:\\Users\\deban\\dev\\humanizer\\* && *)",
      "Bash(git add deliverables/**)",
      "Bash(git add deliverables/*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ],
    "defaultMode": "auto"
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/skillspector-gate.sh\"",
            "timeout": 100
          }
        ]
      },
      {
        "matcher": "mcp__.*|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/redteam-outward-gate.sh\" pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/note-taker.sh\" \"$CLAUDE_TOOL_INPUT_FILE_PATH\"",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format-python.sh\" \"$CLAUDE_TOOL_INPUT_FILE_PATH\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/documenter-prompt.sh\" \"$CLAUDE_TOOL_INPUT_FILE_PATH\"",
            "async": true
          }
        ]
      },
      {
        "matcher": "mcp__.*[Gg]mail.*__(create_draft|update_draft)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/redteam-outward-gate.sh\" post",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 35
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verdict-table-check.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/redteam-outward-gate.sh\" subagent",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-gate.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/redteam-outward-gate.sh\" prompt",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/jev-router-cloud.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disabledMcpjsonServers": [
    "firecrawl",
    "tavily"
  ]
}
