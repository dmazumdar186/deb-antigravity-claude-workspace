   "t": 17.333333333333332,
   "t1": 20.089,
   "f": "F08",
   "text": "Normalise spellings and labels: twenty-six."
  },
  {
   "id": "L08",
   "t": 20.291666666666668,
   "t1": 24.857,
   "f": "F03 F09",
   "text": "Merge twenty-five duplicates, read employers and job titles: forty-nine."
  },
  {
   "id": "L09",
   "t": 25.583333333333332,
   "t1": 26.879,
   "f": "—",
   "text": "But look at the dates."
