 "voice": [
  {
   "id": "L01",
   "beat": 0.5,
   "f": "F01",
   "t": 0.4167,
   "text": "One sentence, from the brief. Graduates working in finance, in London, for more than three years.",
   "dur": 5.461,
   "t1": 5.878
  },
  {
   "id": "L02",
   "beat": 7.5,
   "f": "F01",
   "t": 6.25,
   "text": "One sentence. Four answers.",
   "dur": 2.043,
   "t1": 8.293
  },
  {
   "id": "L03",
   "beat": 10.5,
   "f": "F02",
   "t": 8.75,
   "text": "The file: five hundred and twenty-five records, for five hundred members.",
   "dur": 4.231,
   "t1": 12.981
  },
  {
   "id": "L04",
   "beat": 16,
   "f": "F04",
   "t": 13.3333,
   "text": "Under the loupe, London is spelled eight different ways.",
   "dur": 2.85,
   "t1": 16.183
  },
  {
   "id": "L05",
   "beat": 20,
   "f": "F03",
   "t": 16.6667,
   "text": "And twenty-five people appear twice.",
   "dur": 2.196,
   "t1": 18.863
  },
  {
   "id": "L06",
   "beat": 23.5,
   "f": "F07",
   "t": 19.5833,
   "text": "Filter the file as delivered: two members.",
   "dur": 2.681,
   "t1": 22.264
  },
  {
   "id": "L07",
   "beat": 27.5,
   "f": "F08",
   "t": 22.9167,
   "text": "Normalise the spellings: twenty-six.",
   "dur": 2.355,
   "t1": 25.272
  },
  {
   "id": "L08",
   "beat": 31,
   "f": "F09",
   "t": 25.8333,
   "text": "Remove the duplicates, read employers and job titles: forty-nine.",
   "dur": 4.296,
   "t1": 30.129
  },
  {
   "id": "L09",
   "beat": 38.5,
   "f": "—",
   "t": 32.0833,
   "text": "But look at the dates.",
   "dur": 1.49,
   "t1": 33.573
  },
  {
   "id": "L10",
   "beat": 41,
   "f": "F13",
   "t": 34.1667,
   "text": "Sixty-eight percent of profiles have not been touched in two years or more.",
   "dur": 4.061,
   "t1": 38.228
  },
  {
   "id": "L11",
   "beat": 46.5,
   "f": "F22",
   "t": 38.75,
   "text": "Three years in post, and three years without an update, are the same signal.",
   "dur": 4.294,
   "t1": 43.044
  },
  {
   "id": "L12",
   "beat": 52.5,
   "f": "F17",
   "t": 43.75,
   "text": "One user put it plainly. Three hundred and forty London expats. Twenty had moved back years ago. Two unsubscribed.",
   "dur": 7.529,
   "t1": 51.279
  },
  {
   "id": "L13",
   "beat": 64,
   "f": "F09 F11 F21",
   "t": 53.3333,
   "text": "So the forty-nine split by trust. One current. Five to confirm. Forty-three to reactivate.",
   "dur": 6.11,
   "t1": 59.443
  },
  {
   "id": "L14",
   "beat": 72.5,
   "f": "F12",
   "t": 60.4167,
   "text": "Six can be emailed today.",
   "dur": 1.814,
   "t1": 62.231
  },
  {
   "id": "L15",
   "beat": 77,
   "f": "F19",
   "t": 64.1667,
   "text": "Describe your audience in one sentence. Get a segment you can trust. No member record ever leaves the platform.",
   "dur": 7.025,
   "t1": 71.192
  },
  {
   "id": "L16",
   "beat": 86,
   "f": "F23",
   "t": 71.6667,
   "text": "Trusted Segments, the product.",
   "dur": 1.05,
   "t1": 72.717
  }
 ],
