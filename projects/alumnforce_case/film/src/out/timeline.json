   "f": "F01",
   "text": "One sentence from the brief. Graduates working in finance, in London, for more than three years."
  },
  {
   "id": "L02",
   "t": 6.125,
   "t1": 8.068,
   "f": "F01",
   "text": "One sentence. Four answers."
  },
  {
   "id": "L03",
   "t": 8.25,
   "t1": 11.785,
   "f": "F02",
   "text": "Five hundred and twenty-five rows, for five hundred members."
  },
  {
   "id": "L04",
   "t": 12,
   "t1": 14.372,
   "f": "F04 F26",
   "text": "Under the loupe, London is spelled eight ways."
  },
  {
   "id": "L06",
   "t": 14.583333333333334,
   "t1": 17.122,
   "f": "F07",
   "text": "Filter the file as delivered: two rows."
