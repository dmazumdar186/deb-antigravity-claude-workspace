  {
   "id": "L10",
   "t": 27.083333333333332,
   "t1": 30.838,
   "f": "F13",
   "text": "Sixty-eight percent of profiles: untouched for two years or more."
  },
  {
   "id": "L11",
   "t": 31.041666666666668,
   "t1": 35.058,
   "f": "F22",
   "text": "Three years in post and three years without an update: the same signal."
  },
  {
   "id": "L12",
   "t": 35.583333333333336,
   "t1": 41.302,
   "f": "F17",
   "text": "Three hundred and forty London expats. Twenty had moved back years ago. Two unsubscribed."
  },
  {
