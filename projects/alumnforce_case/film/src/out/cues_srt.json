  "text": "One sentence from the brief:"
 },
 {
  "t0": 2.202,
  "t1": 6.04,
  "text": "“Graduates working in finance in London\nfor more than three years”"
 },
 {
  "t0": 6.125,
  "t1": 8.165,
  "text": "One sentence. Four answers."
 },
 {
  "t0": 8.25,
  "t1": 11.915,
  "text": "525 rows, for 500 members."
 },
 {
  "t0": 12,
  "t1": 14.498,
  "text": "Under the loupe, London is spelled 8 ways."
 },
 {
  "t0": 14.583333333333334,
  "t1": 17.248,
  "text": "Filter the file as delivered: 2 rows."
 },
 {
  "t0": 17.333333333333332,
  "t1": 20.207,
  "text": "Normalise spellings and labels: 26."
 },
 {
  "t0": 20.291666666666668,
  "t1": 25.357,
  "text": "Merge 25 duplicates, read employers\nand job titles: 49."
 },
 {
  "t0": 25.583333333333332,
  "t1": 26.998,
  "text": "But look at the dates."
 },
 {
  "t0": 27.083333333333332,
  "t1": 30.957,
  "text": "68 % of profiles: untouched\nfor 2 years or more."
 },
 {
  "t0": 31.041666666666668,
  "t1": 35.498,
  "text": "Three years in post and three years\nwithout an update: the same signal."
 },
 {
  "t0": 35.583333333333336,
  "t1": 39.918,
  "text": "“340 London expats.\nTwenty had moved back years ago."
 },
 {
  "t0": 40.003,
  "t1": 41.802,
  "text": "Two unsubscribed.”"
 },
 {
  "t0": 42.041666666666664,
  "t1": 44.117,
  "text": "The 49 split by trust:"
 },
 {
  "t0": 44.202,
  "t1": 47.498,
  "text": "1 to send, 5 to confirm,\n43 to reactivate."
 },
 {
  "t0": 47.583333333333336,
  "t1": 49.996,
  "text": "6 worth contacting today."
 },
 {
  "t0": 50.083333333333336,
  "t1": 54.415,
  "text": "The administrator’s problem is not\nbuilding the list. It is believing it."
 },
 {
  "t0": 54.5,
