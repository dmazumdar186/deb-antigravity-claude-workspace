# <PROJECT_NAME> — required env vars (copy to .env, fill in values)
#
# Never commit .env — it is in .gitignore.

# ── LLM (per ~/.claude/rules/model-tier.md) ─────────────────────────────────
# Default provider is Gemini free tier (250 RPD, 10 RPM). Anthropic used
# only when a paid budget is confirmed. GLM 5.2 forbidden for PII per rule.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Cloudflare (for local wrangler + dev) ───────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Basic Auth (dashboard middleware) ───────────────────────────────────────
# Only used LOCALLY via `wrangler pages dev`. Production values live in
# `wrangler pages secret put`.
DASHBOARD_USER=
DASHBOARD_PASS=

# ── Front-door synthetic target ─────────────────────────────────────────────
SITE_URL=https://<PROJECT_DOMAIN>

# ── Turnstile (optional — CAPTCHA) ──────────────────────────────────────────
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
