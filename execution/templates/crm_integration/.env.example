# CRM Integration — required env vars
# Copy to .env and fill in. Never commit .env.

# --- Provider credentials (only fill the one(s) you need) ---
HUBSPOT_ACCESS_TOKEN=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
ATTIO_API_KEY=
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# --- Webhook receive ---
# HMAC secret configured with each CRM's webhook subscription.
WEBHOOK_SECRET=

# --- Destination (Google Sheet path shown) ---
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials.json
DESTINATION_SHEET_ID=

# --- Sandbox account used by tests/acceptance_crm_sync.py ---
# Leave blank unless you have a dedicated sandbox. Acceptance test refuses to
# run against production credentials to avoid mutating real records.
SANDBOX_PROVIDER=
SANDBOX_ACCESS_TOKEN=
SANDBOX_ID=

# --- Runtime knobs ---
CRM_SYNC_MAX_PAGES=100
CRM_SYNC_LOG_DIR=./.tmp/crm_sync_runs
