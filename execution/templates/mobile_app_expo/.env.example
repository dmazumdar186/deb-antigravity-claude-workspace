# {{APP_SLUG}} environment variables
# Copy to .env and fill in values. .env is gitignored.

# --- Required ---
# Base URL of the paired backend (CF Worker or Supabase Edge Function).
# Reference: src/services/api.ts consumes this.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# --- Bundle IDs (fill BEFORE first EAS build) ---
IOS_BUNDLE_ID=com.example.{{APP_SLUG}}
ANDROID_PACKAGE=com.example.{{APP_SLUG}}

# --- EAS ---
# Fill after `eas init`. Also mirrored into execution/mobile_apps/registry.json.
EAS_PROJECT_ID=
# EAS Update channel URL (optional). Fill after `eas update:configure`.
EAS_UPDATE_URL=

# --- Sentry (optional, env-gated no-op if absent) ---
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Analytics (optional, env-gated no-op if absent) ---
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- App Store / Play Console (fill during Phase 5 submit) ---
# APPLE_ENROLLMENT_STATUS: "active" | "pending" | "absent"
# Gates Phases 4-5 of the /mobile-app skill (see execution/mobile_apps/preflight.py).
APPLE_ENROLLMENT_STATUS=absent
