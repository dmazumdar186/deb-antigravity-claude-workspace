# --- Analysis LLM keys (pick provider; default gemini-direct) ---
GEMINI_API_KEY=
# Optional fallbacks:
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Higgsfield MCP ---
# The MCP path uses browser OAuth (interactive Claude session) — no key needed.
# For direct-API fallback (Phase 6+), set this:
HIGGSFIELD_API_KEY=

# --- Publish targets ---
# TikTok publish goes via mcp__higgsfield__tiktok_publish (OAuth on higgsfield.ai/mcp).
# YouTube publish requires YouTube Data API v3 OAuth (client_secret.json + token.json).
YOUTUBE_CLIENT_SECRETS_PATH=
YOUTUBE_TOKEN_PATH=
# Instagram publish requires a Meta Graph API access token scoped to an IG Business account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Observability ---
# Optional: workspace-shared spend log path (defaults to .tmp/video/spend_log.jsonl)
SPEND_LOG_PATH=
