{
  "version": "2026-11-07",
  "note": "Strategies 'Download Reports' CSV -> GreenJobs D1. Headers are matched case/space/punctuation-insensitively against aliases. Real headers are unknown until the first export: add aliases here, never edit the code. on_invalid: reject_row | drop_value. on_too_long: reject_row | truncate.",
  "id_rule": "{site}:strat:{strategies_id}",
  "date_formats": [
    "%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d",
    "%d/%m/%Y %H:%M:%S", "%d/%m/%Y %H:%M", "%d/%m/%Y %I:%M:%S %p", "%d/%m/%Y %I:%M %p", "%d/%m/%Y", "%d/%m/%y",
    "%d-%m-%Y", "%d.%m.%Y", "%d-%b-%Y", "%d-%b-%y", "%d %b %Y", "%d %B %Y", "%d %b %Y %H:%M", "%d %B %Y %H:%M"
  ],
  "date_order_note": "Day-first only (IE/UK). A US-ordered export fails parsing loudly rather than importing swapped dates.",
  "reports": {
    "recruiters": {
      "target_table": "employers",
      "dedupe": "site + strategies_id; warn on duplicate name_norm",
      "activity_chain": ["last_login", "updated", "registered"],
      "require_one_of": [["last_login", "updated", "registered"]],
      "fields": {
        "strategies_id": {"column": "source_id", "required": true, "type": "id", "max_len": 40,
          "aliases": ["Recruiter ID", "RecruiterID", "Client ID", "Advertiser ID", "Company ID", "Employer ID", "ID", "Account ID"]},
        "name": {"column": "name", "required": true, "type": "text", "max_len": 200,
          "aliases": ["Company Name", "Company", "Recruiter Name", "Recruiter", "Organisation", "Organization", "Employer", "Employer Name", "Client Name"]},
        "contact_name": {"column": "contact_name", "type": "text", "max_len": 120, "pii": true,
          "aliases": ["Contact Name", "Contact", "Full Name", "Name", "Main Contact"]},
        "contact_first_name": {"column": null, "type": "text", "max_len": 60, "pii": true,
          "aliases": ["Contact First Name", "First Name", "Forename", "FirstName"]},
        "contact_last_name": {"column": null, "type": "text", "max_len": 60, "pii": true,
          "aliases": ["Contact Last Name", "Contact Surname", "Last Name", "Surname", "LastName"]},
        "contact_email": {"column": "contact_email", "type": "email", "max_len": 254, "pii": true, "on_invalid": "drop_value",
          "aliases": ["Email", "Email Address", "E-mail", "Contact Email", "Recruiter Email", "Login Email", "Username"]},
        "phone": {"column": "phone", "type": "text", "max_len": 40, "pii": true, "on_too_long": "reject_row",
          "aliases": ["Phone", "Telephone", "Tel", "Phone Number", "Contact Number", "Mobile"]},
        "website": {"column": "website", "type": "url", "max_len": 300, "on_invalid": "drop_value",
          "aliases": ["Website", "Web Site", "URL", "Web Address", "Company Website", "Homepage"]},
        "logo": {"column": "logo_key", "type": "filename", "max_len": 200, "on_invalid": "drop_value",
          "aliases": ["Logo", "Logo File", "Logo Filename", "Logo Image", "Company Logo", "Image"]},
        "last_login": {"column": "last_active_at", "type": "date", "on_invalid": "drop_value",
          "aliases": ["Last Login", "Last Logged In", "Last Login Date", "Last Visit", "Last Active", "Last Activity"]},
        "updated": {"column": null, "type": "date", "on_invalid": "drop_value",
          "aliases": ["Last Updated", "Updated", "Date Updated", "Modified", "Date Modified", "Last Modified"]},
        "registered": {"column": null, "type": "date", "on_invalid": "drop_value",
          "aliases": ["Date Registered", "Registered", "Registration Date", "Date Created", "Created", "Created Date", "Join Date", "Date Joined"]}
      }
    },
    "candidates": {
      "target_table": "candidates",
      "dedupe": "site + lower(trim(email)); same strategies_id with a different email keeps the latest and warns",
      "activity_chain": ["last_login", "updated", "registered"],
      "require_one_of": [["last_login", "updated", "registered"]],
      "fields": {
        "strategies_id": {"column": "source_id", "required": true, "type": "id", "max_len": 40,
          "aliases": ["Candidate ID", "CandidateID", "Jobseeker ID", "Job Seeker ID", "Member ID", "User ID", "Registration ID", "ID"]},
        "email": {"column": "email_norm", "required": true, "type": "email", "max_len": 254, "pii": true,
          "aliases": ["Email", "Email Address", "E-mail", "E-mail Address", "Candidate Email", "Login Email", "Username"]},
        "first_name": {"column": "first_name", "type": "text", "max_len": 60, "pii": true,
          "aliases": ["First Name", "Forename", "FirstName", "Given Name", "Christian Name"]},
        "last_name": {"column": "last_name", "type": "text", "max_len": 60, "pii": true,
          "aliases": ["Last Name", "Surname", "LastName", "Family Name"]},
        "phone": {"column": "phone", "type": "text", "max_len": 40, "pii": true,
          "aliases": ["Phone", "Telephone", "Tel", "Phone Number", "Mobile", "Mobile Number", "Contact Number"]},
        "location": {"column": "location", "type": "text", "max_len": 120, "pii": true, "on_too_long": "truncate",
          "aliases": ["Location", "Town", "City", "Town/City", "County", "Area", "Address"]},
        "sectors": {"column": "sectors_json", "type": "list", "max_len": 2000,
          "aliases": ["Sectors", "Sector", "Job Sectors", "Categories", "Category", "Industries", "Industry"]},
        "consent_marketing": {"column": "consent_marketing", "type": "bool", "on_invalid": "drop_value",
          "aliases": ["Newsletter", "Receive Newsletter", "Opt In", "Opt-in", "Marketing", "Marketing Consent", "Job Alerts", "Subscribe"]},
        "cv_filename": {"column": null, "type": "filename", "max_len": 200, "pii": false,
          "aliases": ["CV", "CV File", "CV Filename", "Resume", "CV Name", "Attachment"]},
        "registered": {"column": "registered_at", "type": "date", "on_invalid": "drop_value",
          "aliases": ["Date Registered", "Registered", "Registration Date", "Date Created", "Created", "Join Date", "Date Joined"]},
        "last_login": {"column": "last_active_at", "type": "date", "on_invalid": "drop_value",
          "aliases": ["Last Login", "Last Logged In", "Last Login Date", "Last Visit", "Last Active", "Last Activity"]},
        "updated": {"column": null, "type": "date", "on_invalid": "drop_value",
          "aliases": ["Last Updated", "Updated", "Date Updated", "Modified", "Date Modified", "Last Modified"]}
      }
    },
    "profiles": {
      "target_table": "candidates",
      "merge": "by strategies candidate id -> email (from --candidates-csv kept rows) or the profile's own email column",
      "dedupe": "site + candidate strategies_id, latest wins",
      "activity_chain": ["updated", "registered"],
      "require_one_of": [["updated", "registered"]],
      "fields": {
        "candidate_id": {"column": "source_id", "required": true, "type": "id", "max_len": 40,
          "aliases": ["Candidate ID", "CandidateID", "Jobseeker ID", "Member ID", "User ID", "ID"]},
        "email": {"column": "email_norm", "type": "email", "max_len": 254, "pii": true,
          "aliases": ["Email", "Email Address", "E-mail", "Candidate Email"]},
        "headline": {"column": "headline", "type": "text", "max_len": 200, "on_too_long": "truncate",
          "aliases": ["Headline", "Profile Title", "Title", "Profile Headline", "Current Job Title", "Job Title", "Summary"]},
        "location": {"column": "location", "type": "text", "max_len": 120, "pii": true, "on_too_long": "truncate",
          "aliases": ["Location", "Preferred Location", "Town", "City", "Region"]},
        "sectors": {"column": "sectors_json", "type": "list", "max_len": 2000,
          "aliases": ["Sectors", "Sector", "Preferred Sectors", "Categories", "Category", "Industries"]},
        "cv_filename": {"column": null, "type": "filename", "max_len": 200,
          "aliases": ["CV", "CV File", "CV Filename", "Resume", "Attachment"]},
        "updated": {"column": "last_active_at", "type": "date", "on_invalid": "drop_value",
          "aliases": ["Last Updated", "Updated", "Date Updated", "Profile Updated", "Modified", "Date Modified"]},
        "registered": {"column": null, "type": "date", "on_invalid": "drop_value",
          "aliases": ["Date Created", "Created", "Date Registered", "Registered"]}
      }
    },
    "jobs": {
      "target_table": "jobs",
      "dedupe": "site + strategies job id, latest wins",
      "activity_chain": ["updated", "posted", "closing"],
      "require_one_of": [["updated", "posted", "closing"]],
      "fields": {
        "strategies_id": {"column": "source_id", "required": true, "type": "id", "max_len": 40,
          "aliases": ["Job ID", "JobID", "Vacancy ID", "Job Ref ID", "Advert ID", "ID"]},
        "employer_id": {"column": "employer_id", "type": "id", "max_len": 40, "on_invalid": "drop_value",
          "aliases": ["Recruiter ID", "RecruiterID", "Client ID", "Advertiser ID", "Company ID", "Employer ID"]},
        "title": {"column": "title", "required": true, "type": "text", "max_len": 160, "min_len": 3,
          "aliases": ["Job Title", "Title", "Position", "Vacancy Title", "Role"]},
        "location": {"column": "location", "required": true, "type": "text", "max_len": 120, "on_too_long": "truncate",
          "aliases": ["Location", "Job Location", "Town", "City", "Place"]},
        "region": {"column": "region", "type": "text", "max_len": 80, "on_too_long": "truncate",
          "aliases": ["Region", "County", "Area"]},
        "job_type": {"column": "job_type", "type": "text", "max_len": 40, "on_too_long": "truncate",
          "aliases": ["Job Type", "Type", "Contract Type", "Employment Type", "Hours"]},
        "sal_min": {"column": "sal_min", "type": "money", "on_invalid": "drop_value",
          "aliases": ["Salary From", "Salary Min", "Min Salary", "Minimum Salary", "Salary Low"]},
        "sal_max": {"column": "sal_max", "type": "money", "on_invalid": "drop_value",
          "aliases": ["Salary To", "Salary Max", "Max Salary", "Maximum Salary", "Salary High"]},
        "currency": {"column": "currency", "type": "text", "max_len": 8, "on_too_long": "truncate",
          "aliases": ["Currency", "Salary Currency"]},
        "period": {"column": "period", "type": "text", "max_len": 20, "on_too_long": "truncate",
          "aliases": ["Salary Period", "Period", "Per", "Salary Per", "Pay Period"]},
        "sal_text": {"column": "sal_text", "type": "text", "max_len": 120, "on_too_long": "truncate",
          "aliases": ["Salary", "Salary Text", "Salary Description", "Pay", "Remuneration"]},
        "sectors": {"column": "sectors_json", "type": "list", "max_len": 2000,
          "aliases": ["Sectors", "Sector", "Categories", "Category", "Job Sectors", "Industry"]},
        "summary": {"column": "summary", "type": "text", "max_len": 500, "on_too_long": "truncate",
          "aliases": ["Summary", "Short Description", "Job Summary", "Intro", "Teaser"]},
        "description": {"column": "description", "required": true, "type": "text", "max_len": 20000, "min_len": 20,
          "aliases": ["Description", "Job Description", "Full Description", "Details", "Body", "Advert Text"]},
        "apply_email": {"column": "apply_email", "type": "email", "max_len": 254, "on_invalid": "drop_value",
          "aliases": ["Apply Email", "Application Email", "Contact Email", "Email", "Response Email"]},
        "apply_url": {"column": "apply_url", "type": "url", "max_len": 500, "on_invalid": "drop_value",
          "aliases": ["Apply URL", "Application URL", "External URL", "Apply Link", "Redirect URL"]},
        "posted": {"column": "posted_at", "type": "date", "on_invalid": "drop_value",
          "aliases": ["Date Posted", "Posted", "Posted Date", "Start Date", "Live Date", "Date Created", "Created"]},
        "closing": {"column": "closing_at", "type": "date", "on_invalid": "drop_value",
          "aliases": ["Closing Date", "Close Date", "Expiry Date", "Expires", "End Date", "Deadline"]},
        "updated": {"column": null, "type": "date", "on_invalid": "drop_value",
          "aliases": ["Last Updated", "Updated", "Date Updated", "Modified", "Date Modified"]}
      }
    },
    "applications": {
      "target_table": "applications",
      "dedupe": "dedupe_key = sha256(site|job_id|applicant_email_norm), job_id = the D1 job id '{site}:strat:{job id}'; latest submitted wins",
      "activity_chain": ["submitted"],
      "require_one_of": [["submitted"], ["applicant_name", "first_name", "last_name"]],
      "fields": {
        "strategies_id": {"column": "source_id", "type": "id", "max_len": 40, "on_invalid": "drop_value",
          "aliases": ["Application ID", "ApplicationID", "Response ID", "Apply ID", "ID"]},
        "job_id": {"column": "job_id", "required": true, "type": "id", "max_len": 40,
          "aliases": ["Job ID", "JobID", "Vacancy ID", "Advert ID"]},
        "applicant_name": {"column": "applicant_name", "type": "text", "max_len": 120, "pii": true,
          "aliases": ["Name", "Applicant Name", "Candidate Name", "Full Name", "Applicant"]},
        "first_name": {"column": null, "type": "text", "max_len": 60, "pii": true,
          "aliases": ["First Name", "Forename", "FirstName"]},
        "last_name": {"column": null, "type": "text", "max_len": 60, "pii": true,
          "aliases": ["Last Name", "Surname", "LastName"]},
        "applicant_email": {"column": "applicant_email", "required": true, "type": "email", "max_len": 254, "pii": true,
          "aliases": ["Email", "Email Address", "E-mail", "Applicant Email", "Candidate Email"]},
        "phone": {"column": "phone", "type": "text", "max_len": 40, "pii": true,
          "aliases": ["Phone", "Telephone", "Tel", "Phone Number", "Mobile", "Contact Number"]},
        "cover_note": {"column": "cover_note", "type": "text", "max_len": 5000, "pii": true, "on_too_long": "truncate",
          "aliases": ["Cover Letter", "Cover Note", "Covering Letter", "Message", "Comments", "Notes"]},
        "cv_filename": {"column": null, "type": "filename", "max_len": 200,
          "aliases": ["CV", "CV File", "CV Filename", "Resume", "Attachment"]},
        "submitted": {"column": "submitted_at", "type": "date", "on_invalid": "drop_value",
          "aliases": ["Date Applied", "Applied", "Application Date", "Date Submitted", "Submitted", "Date", "Response Date", "Created"]}
      }
    }
  }
}
