{
  "version": "2026-11-20",
  "note": "Strategies 'Download Reports' CSV -> GreenJobs D1. Aliases are the REAL header names from the client's 19 Nov header rows (build/import/REAL_HEADERS_2026-11-19.json), IE and UK. Matching is case/space/punctuation-insensitive and by name only, never by position. A header listed twice is never mapped. ignored_headers are real columns deliberately not imported. Add aliases here, never edit the code. on_invalid: reject_row | drop_value. on_too_long: reject_row | truncate.",
  "id_rule": "{site}:strat:{strategies_id}",
  "date_formats": [
    "%Y-%m-%dT%H:%M:%SZ",
    "%Y-%m-%dT%H:%M:%S",
    "%Y-%m-%d %H:%M:%S",
    "%Y-%m-%d %H:%M",
    "%Y-%m-%d",
    "%d/%m/%Y %H:%M:%S",
    "%d/%m/%Y %H:%M",
    "%d/%m/%Y %I:%M:%S %p",
    "%d/%m/%Y %I:%M %p",
    "%d/%m/%Y",
    "%d/%m/%y",
    "%d-%m-%Y",
    "%d.%m.%Y",
    "%d-%b-%Y",
    "%d-%b-%y",
    "%d %b %Y",
    "%d %B %Y",
    "%d %b %Y %H:%M",
    "%d %B %Y %H:%M"
  ],
  "date_order_note": "Day-first only (IE/UK). A US-ordered export fails parsing loudly rather than importing swapped dates.",
