---
const year = new Date().getFullYear();
---
<footer class="rule-top">
  <div class="section-inner px-5 py-12 grid gap-10 md:grid-cols-3 text-sm text-ink-500">
    <div>
      <div class="font-serif text-lg text-ink-800 mb-2">Debanjan Mazumdar</div>
      <div>Fractional AI PM and Builder</div>
      <div>Paris, France</div>
      <div class="mt-3">
        <a href="mailto:debanjan@debanjanm.com" class="underline underline-offset-4 hover:text-ink-800">
          debanjan@debanjanm.com
        </a>
      </div>
    </div>

    <div>
      <div class="text-xs uppercase tracking-widest text-ink-800 mb-3 font-semibold">Postal address</div>
      <div>[TO_FILL - postal address per legal/lia.md]</div>
      <div class="mt-3 text-xs">
        SIRET: [TO_FILL - SIRET]
      </div>
    </div>

    <div>
      <div class="text-xs uppercase tracking-widest text-ink-800 mb-3 font-semibold">
        If you got here from an email
      </div>
      <p class="mb-3">
        To stop receiving messages, reply STOP or email
        <a href="mailto:unsubscribe@debanjanm.com" class="underline underline-offset-4 hover:text-ink-800">
          unsubscribe@debanjanm.com
        </a>.
        Suppression is honoured immediately and permanently.
      </p>
      <p>
        <a href="/legal/lia" class="underline underline-offset-4 hover:text-ink-800">
          Legitimate Interest Assessment (LIA)
        </a>
      </p>
    </div>
  </div>

  <div class="rule-top">
    <div class="section-inner px-5 py-6 text-xs text-ink-500 flex flex-wrap gap-x-6 gap-y-2 justify-between">
      <div>Copyright {year} Debanjan Mazumdar. All rights reserved.</div>
      <div class="flex gap-4">
        <a href="/legal/lia" class="hover:text-ink-800">Legal / LIA</a>
        <a href="https://prodcraft.fyi" class="hover:text-ink-800">ProdCraft</a>
      </div>
    </div>
  </div>
</footer>
