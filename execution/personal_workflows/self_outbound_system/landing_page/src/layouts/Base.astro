---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  path?: string;
}

const {
  title,
  description,
  noindex = false,
  path = '/',
} = Astro.props;

const SITE = 'https://debanjanm.com';
const canonicalUrl = `${SITE}${path}`;

const defaultDesc = 'Debanjan Mazumdar - Fractional AI PM and Builder in Paris. Fixed-price AI builds for founders, heads of product, and agency owners. 1 to 2 weeks turnaround.';
const desc = description ?? defaultDesc;

// Schema.org - Person + ProfessionalService
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE}/#debanjan`,
      name: 'Debanjan Mazumdar',
      jobTitle: 'Fractional AI Product Manager and Builder',
      url: SITE,
      email: 'debanjan@debanjanm.com',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Paris',
        addressCountry: 'FR',
      },
      knowsLanguage: ['en', 'fr'],
      knowsAbout: [
        'AI product management',
        'LLM applications',
        'Retrieval-augmented generation',
        'Evaluation harnesses',
        'Product engineering',
      ],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#service`,
      name: 'Debanjan Mazumdar - AI Product Consulting',
      provider: { '@id': `${SITE}/#debanjan` },
      areaServed: [
        { '@type': 'Country', name: 'France' },
        { '@type': 'Place', name: 'Remote worldwide' },
      ],
      priceRange: 'EUR 1000 - EUR 2500',
      url: SITE,
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalUrl} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
</head>
<body class="min-h-screen antialiased">
  <slot />
</body>
</html>
