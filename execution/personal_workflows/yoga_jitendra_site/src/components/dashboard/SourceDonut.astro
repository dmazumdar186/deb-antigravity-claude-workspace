---
// SourceDonut — pie/donut showing which discovery channel drove the clicks.
//
// Per plan §3.3, the donut shows CLICKS (not WA-taps) because clicks is the
// only metric all four sources contribute to. Degraded sources appear with
// a hatched fill + "no data" annotation so the chart never silently drops
// a category.
//
// Hydrates from CustomEvent('dashboarddata') like TimeSeriesChart.
//
// 2026-08-04 fix: same bare-specifier fix as TimeSeriesChart.astro — inline
// `<script type="module" define:vars>` blocks cannot resolve
// `import ApexCharts from 'apexcharts'` in the browser, which is why "Where
// clicks come from" has been blank since V0.1 shipped. Initial data now
// flows via `data-init` JSON attribute; the hoisted `<script>` gets Astro-
// bundled and the import resolves.

interface Props {
  labels: string[];
  values: number[];
  degraded_source_indices?: number[];
}
const { labels, values, degraded_source_indices = [] } = Astro.props;
const initJson = JSON.stringify({
  labels: Array.isArray(labels) ? labels : [],
  values: Array.isArray(values) ? values : [],
  degraded_source_indices: Array.isArray(degraded_source_indices) ? degraded_source_indices : [],
});
---
<div class="donut-block" data-reveal>
  <p class="eyebrow"><span class="breathing-dot"></span><span>Discovery mix</span></p>
  <h2 class="dash-h2">Where clicks come from</h2>
  <div
    id="source-donut-chart"
    class="chart-host"
    data-init={initJson}
    aria-label="Donut chart: click share by discovery channel"
  ></div>
  <p class="chart-source">Source: Google Search Console + Business Profile + Bing + On-site beacon</p>
</div>

<script>
  import ApexCharts from 'apexcharts';

  const INK_SOFT = 'rgba(74, 66, 59, 0.7)';
  const TERRACOTTA = '#c9744a';
  const SAGE = '#6b7a5a';
  const INK = '#2e2a26';
  const SAND = 'rgba(217, 199, 167, 0.9)';
  const PALETTE = [TERRACOTTA, SAGE, INK, SAND];

  function buildOptions(labels: string[], values: number[], degradedIndices: number[]) {
    // Fill non-degraded slices from the palette; degraded slices get a
    // pale sand fill and appear in the legend with a "pending" note.
    // 2026-08-04: for the case where GBP is permanently degraded (Google
    // denied API access), the "no data yet" wording is misleading — nothing
    // is coming. We surface it as "(pending API approval)" so the client
    // reads the state truthfully. Other transient-degraded sources still
    // read as "(no data yet)".
    const GBP_LABEL = 'Google Maps';
    const colors = (labels || []).map((_, i) =>
      degradedIndices.includes(i) ? 'rgba(217, 199, 167, 0.35)' : PALETTE[i % PALETTE.length]
    );
    const totalClicks = (values || []).reduce((a, b) => a + (b || 0), 0);
    const decoratedLabels = (labels || []).map((l, i) => {
      if (!degradedIndices.includes(i)) return l;
      if (l === GBP_LABEL) return `${l} (pending API approval)`;
      return `${l} (no data yet)`;
    });
    return {
      chart: {
        type: 'donut',
        height: 300,
        background: 'transparent',
        fontFamily: 'Inter, system-ui, sans-serif',
        animations: { enabled: true, speed: 500 },
      },
      series: values || [],
      labels: decoratedLabels,
      colors,
      stroke: { width: 0 },
      dataLabels: {
        enabled: totalClicks > 0,
        style: { fontSize: '11px', fontFamily: 'Inter', fontWeight: 500, colors: ['#fff'] },
        formatter: (val: number) => val >= 5 ? `${val.toFixed(0)}%` : '',
        dropShadow: { enabled: false },
      },
      legend: {
        position: 'bottom',
        fontSize: '12px',
        labels: { colors: INK_SOFT },
        markers: { radius: 3 },
        itemMargin: { horizontal: 10, vertical: 4 },
      },
      plotOptions: {
        pie: {
          donut: {
            size: '58%',
            labels: {
              show: true,
              total: {
                show: true,
                label: 'Total clicks',
                fontSize: '11px',
                fontFamily: 'Inter',
                color: INK_SOFT,
                formatter: () => totalClicks.toLocaleString('en-US'),
              },
              value: {
                fontSize: '20px',
                fontFamily: 'Fraunces, serif',
                color: INK,
              },
            },
          },
        },
      },
      tooltip: {
        y: { formatter: (v: number | null) => (v == null ? '—' : `${v.toLocaleString('en-US')} clicks`) },
      },
      noData: {
        text: 'No clicks recorded yet — see the status banner above for the reason.',
        align: 'center',
        verticalAlign: 'middle',
        style: { color: INK, fontSize: '15px' },
      },
    };
  }

  function initDonut() {
    const el = document.getElementById('source-donut-chart') as HTMLDivElement | null;
    if (!el) return;
    let initialLabels: string[] = [];
    let initialValues: number[] = [];
    let initialDegraded: number[] = [];
    try {
      const raw = el.dataset.init;
      if (raw) {
        const parsed = JSON.parse(raw);
        initialLabels = Array.isArray(parsed.labels) ? parsed.labels : [];
        initialValues = Array.isArray(parsed.values) ? parsed.values : [];
        initialDegraded = Array.isArray(parsed.degraded_source_indices) ? parsed.degraded_source_indices : [];
      }
    } catch (err) {
      console.warn('source-donut init JSON parse failed (rendering empty chart)', err);
    }

    const chart = new ApexCharts(el, buildOptions(initialLabels, initialValues, initialDegraded));
    chart.render();

    window.addEventListener('dashboarddata', (ev: Event) => {
      const rollup = (ev as CustomEvent).detail?.rollup;
      if (!rollup?.source_split) return;
      const { labels: newLabels, values: newValues, degraded_source_indices: newDeg } = rollup.source_split;
      chart.updateOptions(buildOptions(newLabels || [], newValues || [], newDeg || []));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDonut);
  } else {
    initDonut();
  }
</script>

<style>
  .donut-block {
    background: var(--cream-100);
    border: 1px solid rgba(46, 42, 38, 0.08);
    border-radius: 1.25rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .chart-host {
    min-height: 300px;
    width: 100%;
    margin-top: 0.5rem;
  }
  .chart-source {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(74, 66, 59, 0.55);
    margin: 0.75rem 0 0 0.25rem;
    font-weight: 500;
  }
  :global(.chart-host .apexcharts-legend-text) {
    font-family: 'Inter', system-ui, sans-serif !important;
  }
</style>
