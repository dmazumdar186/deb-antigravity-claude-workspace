---
// HeroTile — one of the three big-number tiles at the top of the dashboard.
//
// V0.1: accepts an optional `sparkline` array + `metric_key` + `delta_pct`
// so the tile renders a mini-chart under the number and shows the
// week-over-week delta when available. Values also carry a stable
// data-metric attribute so the dashboard hydration script can update
// them on range-pill click without a full re-render.
//
// Contract with dashboard.astro:
//   - .hero-tile-bignumber [data-metric] holds the primary number.
//   - .hero-tile-delta [data-metric] holds the delta_pct pill.
//   - Sparkline component listens for the same CustomEvent bus.

import Sparkline from './Sparkline.astro';

interface Props {
  eyebrow: string;
  headline: string;
  value: string | number | null;
  status: 'live' | 'waiting';
  hint?: string;
  source: string;
  suffix?: string;
  metric_key?: 'reach' | 'interest' | 'conversation';
  sparkline?: number[];
  delta_pct?: number | null;
  sparkline_color?: string;
  // 2026-08-04 fix: when live rollup returns value === 0 but at least one of
  // the tile's needed sources is degraded, we render the number in a muted
  // style with a truthful caveat naming the still-pending source(s). Prior
  // behavior rendered a bare `0—` with no context — visually identical to a
  // healthy zero, which mis-signalled a broken pipeline as a real result.
  partial_caveat?: string | null;
}
const {
  eyebrow,
  headline,
  value,
  status,
  hint,
  source,
  suffix,
  metric_key,
  sparkline = [],
  delta_pct = null,
  sparkline_color = 'var(--terracotta)',
  partial_caveat = null,
} = Astro.props;

const isLive = status === 'live' && value !== null && value !== undefined;
// Partial-live: a real zero from a not-yet-complete pipeline. Only kicks in
// when the value is exactly 0 AND caller declared at least one source is
// still pending. A non-zero live value is never "partial" — real data wins.
const isPartial = isLive && value === 0 && !!partial_caveat;

function formatDelta(pct: number | null): string {
  if (pct === null || pct === undefined) return '—';
  const sign = pct > 0 ? '+' : '';
  return `${sign}${pct.toFixed(1)}%`;
}
const deltaCls = delta_pct === null || delta_pct === undefined
  ? 'delta-neutral'
  : delta_pct > 0 ? 'delta-up' : delta_pct < 0 ? 'delta-down' : 'delta-neutral';
---
<article class="hero-tile" data-status={status} data-tile-key={metric_key} data-partial={isPartial ? 'true' : undefined} data-reveal>
  <p class="hero-tile-eyebrow">
    <span class="breathing-dot"></span>
    <span>{eyebrow}</span>
  </p>
  <h3 class="hero-tile-headline">{headline}</h3>
  <div class="hero-tile-number-row">
    {isLive ? (
      <>
        <div class="hero-tile-number-line">
          <span class={`hero-tile-bignumber${isPartial ? ' partial' : ''}`} data-metric={metric_key}>
            {typeof value === 'number' ? value.toLocaleString('en-US') : value}{suffix && <span class="hero-tile-suffix">{suffix}</span>}
          </span>
          {metric_key && (
            <span class={`hero-tile-delta ${deltaCls}`} data-metric-delta={metric_key} aria-label="Change vs previous window">
              {formatDelta(delta_pct)}
            </span>
          )}
        </div>
        {isPartial && (
          <p class="hero-tile-caveat" data-metric-caveat={metric_key}>{partial_caveat}</p>
        )}
        {metric_key && sparkline.length > 0 && (
          <Sparkline
            id={`sparkline-${metric_key}`}
            data={sparkline}
            color={sparkline_color}
            metric_key={metric_key}
          />
        )}
      </>
    ) : (
      <span class="hero-tile-skeleton" role="status">
        <span class="hero-tile-hourglass" aria-hidden="true">&#x23F3;</span>
        <span>{hint}</span>
      </span>
    )}
  </div>
  <p class="hero-tile-source">Source: {source}</p>
</article>

<style>
  .hero-tile {
    background: var(--cream-100);
    border: 1px solid rgba(46, 42, 38, 0.08);
    border-radius: 1.25rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 210px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .hero-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -24px rgba(46, 42, 38, 0.25);
  }
  .hero-tile-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
    font-weight: 500;
    margin: 0;
    display: inline-flex;
    align-items: center;
  }
  .hero-tile-headline {
    font-weight: 500;
    font-size: 1.1rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink-soft);
    margin: 0;
  }
  .hero-tile-number-row {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .hero-tile-number-line {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .hero-tile-bignumber {
    font-family: var(--font-display, 'Fraunces'), 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    font-weight: 500;
    color: var(--terracotta);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  /* 2026-08-04: muted colour for a "partial" zero — a real 0 read from
     the pipeline where at least one source is still pending. Distinguishes
     it from a genuine zero (where every source is contributing and the
     terracotta number is the honest answer). */
  .hero-tile-bignumber.partial {
    color: rgba(74, 66, 59, 0.55);
  }
  .hero-tile-caveat {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 32ch;
  }
  .hero-tile-suffix {
    font-size: 0.55em;
    margin-left: 0.35rem;
    color: var(--ink-soft);
  }
  .hero-tile-delta {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  /* Palette stays honest: sage for up, terracotta-soft for down, sand for
     null/threshold-suppressed. No red — even a drop is not shamed with red
     per parent-project non-negotiable. */
  .delta-up {
    background: rgba(107, 122, 90, 0.18);
    color: var(--sage);
  }
  .delta-down {
    background: rgba(201, 116, 74, 0.14);
    color: var(--terracotta);
  }
  .delta-neutral {
    background: rgba(217, 199, 167, 0.35);
    color: rgba(74, 66, 59, 0.7);
  }
  .hero-tile-skeleton {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px dashed rgba(201, 116, 74, 0.4);
    background: rgba(217, 199, 167, 0.18);
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .hero-tile-hourglass {
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .hero-tile-source {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(74, 66, 59, 0.6);
    margin: 0;
    font-weight: 500;
  }
</style>
