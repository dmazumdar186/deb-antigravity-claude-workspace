---
import '../styles/base.css';
import DevHUD from '../components/DevHUD.tsx';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AgentUp — daily AI-powered training for call-centre agents.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tabs = [
  { href: '/',          label: 'Daily Training',  match: (p: string) => p === '/' },
  { href: '/cases',     label: 'My Cases',        match: (p: string) => p.startsWith('/cases') },
  { href: '/dashboard', label: 'My Dashboard',    match: (p: string) => p.startsWith('/dashboard') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12141A" />
    <title>{title} · AgentUp</title>
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Apply dark-mode class before first paint (avoids flash).
      try {
        const saved = localStorage.getItem('agentup:theme');
        const prefers = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefers)) document.documentElement.classList.add('dark');
      } catch { /* localStorage may throw in private mode; ignore */ }
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:btn-primary">Skip to content</a>
    <header class="sticky top-0 z-30 border-b border-ink-200/60 dark:border-ink-700/60 bg-ink-50/85 dark:bg-ink-950/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex items-baseline gap-2 font-display font-semibold tracking-tight">
          <span aria-hidden="true" class="inline-flex h-7 w-7 translate-y-[3px] items-center justify-center rounded-md bg-ink-900 text-emerald-400 dark:bg-white dark:text-ink-900 font-black leading-none shadow-sm">▲</span>
          <span class="text-xl">Agent<span class="text-ink-500 dark:text-ink-400">Up</span></span>
        </a>
        <nav aria-label="Primary" class="flex items-center gap-1">
          {tabs.map((t) => {
            const active = t.match(path);
            return (
              <a
                href={t.href}
                class:list={[
                  'rounded-lg px-3 py-1.5 text-sm font-medium transition',
                  active
                    ? 'bg-white dark:bg-ink-900 text-ink-900 dark:text-white shadow-sm ring-1 ring-ink-200/70 dark:ring-ink-700/70'
                    : 'text-ink-700 dark:text-ink-300 hover:text-ink-900 dark:hover:text-white',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {t.label}
              </a>
            );
          })}
        </nav>
        <button
          type="button"
          id="theme-toggle"
          class="btn-ghost !px-2.5 !py-1.5"
          aria-label="Toggle theme"
        >
          <span class="dark:hidden">🌙</span>
          <span class="hidden dark:inline">☀️</span>
        </button>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-6xl px-4 pb-24 pt-6 md:pt-10">
      <slot />
    </main>

    <footer class="mx-auto max-w-6xl px-4 pb-8 text-center text-xs text-ink-500">
      AgentUp · hiring-interview build · Powered by Claude Sonnet 4.6 (with Gemini 2.5 fallback) on Cloudflare Pages
    </footer>

    <DevHUD client:only="react" />


    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      if (btn) btn.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('agentup:theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
  </body>
</html>
