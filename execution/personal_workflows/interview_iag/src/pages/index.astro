---
import Layout from '../layouts/Layout.astro';
import TrainingIsland from '../components/TrainingIsland.tsx';
---
<Layout title="Daily Training">
  <section class="animate-fade-in">
    <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
      Daily Training
    </h1>
    <p class="mt-2 max-w-2xl text-ink-600 dark:text-ink-300">
      Three AI-roleplay scenarios, five turns each. Sharpen empathy, accuracy,
      resolution, and professionalism before your shift.
    </p>
    <div class="mt-8">
      <TrainingIsland client:load />
    </div>
  </section>
</Layout>
