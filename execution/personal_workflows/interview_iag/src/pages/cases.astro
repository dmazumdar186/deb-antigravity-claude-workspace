---
import Layout from '../layouts/Layout.astro';
import CasesIsland from '../components/CasesIsland.tsx';
---
<Layout title="My Cases">
  <section class="animate-fade-in">
    <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">My Cases</h1>
    <p class="mt-2 max-w-2xl text-ink-600 dark:text-ink-300">
      Your personal library of practice scenarios — five defaults ship with the app;
      add your own to target skills you want to sharpen.
    </p>
    <div class="mt-8">
      <CasesIsland client:load />
    </div>
  </section>
</Layout>
