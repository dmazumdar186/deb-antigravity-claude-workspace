{
  "name": "agentup-iag",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "AgentUp — daily AI-powered training for BPO/call-centre agents. Hiring interview build for IAG Services.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test && npm run test:e2e",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2024-11-01",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^5.0.0",
    "recharts": "^2.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@astrojs/react": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8",
    "wrangler": "^3.90.0"
  }
}
