{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "ASSET Voyages : démo congrès (administration)",
		"description": "Back-office connecté en tant que « direction » (Direction ASSET) : congrès, demandes de devis, codes GM&E protégés. Données fictives. ASSET_GME_KEY ci-dessous : clé publique de démonstration uniquement.",
		"author": "ProdCraft"
	},
	"landingPage": "/wp-admin/admin.php?page=asset-demandes",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"ASSET_GME_KEY": "6efdc2e7995c6fff36b185a638d326a3a0f71cca0046d4238a114e29595a2852",
				"ASSET_GME_KEY_NOTICE": "DEMO ONLY: public sandbox key, never reuse in production (see README)"
			}
		},
		{
			"step": "setSiteLanguage",
			"language": "fr_FR"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"timezone_string": "Europe/Paris",
				"date_format": "d/m/Y",
				"time_format": "H:i",
				"start_of_week": 1
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "__PLUGIN_ZIP_URL__"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; asset_congres_demo_seed();"
		},
		{
			"step": "activateTheme",
			"themeFolderName": "asset-demo"
		},
		{
			"step": "login",
			"username": "direction",
			"password": "demo-asset"
		}
	]
}
