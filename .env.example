FRANCE_TRAVAIL_CLIENT_SECRET=
# INSEE SIRENE V3.11 — register at https://api.insee.fr
# Prefer long-lived bearer key; fall back to OAuth2 with CLIENT_ID/SECRET below if needed
INSEE_SIRENE_API_KEY=
# INSEE_SIRENE_CLIENT_ID=
# INSEE_SIRENE_CLIENT_SECRET=
# Gmail SMTP — generate App Password at https://myaccount.google.com/apppasswords (requires 2FA)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Where the daily digest is delivered
JOB_TRACKER_RECIPIENT=
# Optional override; defaults to .tmp/job_tracker.db
# JOB_TRACKER_DB_PATH=.tmp/job_tracker.db
GEMINI_API_KEY=

